PORT=3000
MONGO_URI=mongodb://localhost:27017/calories-tracker
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
AI_API_KEY=your_token_here
# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI-лимиты: бесплатный и Plus (по умолчанию 10 и 300)
AI_MONTHLY_LIMIT=10
AI_PREMIUM_MONTHLY_LIMIT=300
